{
  "name": "sri-bharathi-manager",
  "version": "1.1.1",
  "private": true,
  "description": "Sri Bharathi PG for Women - hostel occupancy & billing manager",
  "author": "Sri Bharathi PG",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:app": "cross-env SBH_DEV_URL=http://localhost:5178 electron .",
    "build": "vite build",
    "build:web": "cross-env SBH_TARGET=web vite build",
    "preview:web": "cross-env SBH_TARGET=web vite build && vite preview --outDir dist-web --port 5179",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "package": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "exceljs": "^4.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "cross-env": "^10.0.0",
    "electron": "^38.1.0",
    "electron-builder": "^25.1.8",
    "jsdom": "^30.0.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "in.sribharathi.manager",
    "productName": "Sri Bharathi Manager",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Sri Bharathi Manager"
    }
  }
}
